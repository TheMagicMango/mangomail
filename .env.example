MANGOMAIL_RESEND_API_KEY=re_your_resend_api_key_here

MANGOMAIL_API_KEY=your_secret_api_key_here

MANGOMAIL_RATE_LIMIT=2

MANGOMAIL_LOG_LEVEL=info

# Optional: Allowed origins for CORS, comma-separated (default: *)
# Examples:
#   - Allow all: *
#   - Single origin: https://example.com
#   - Multiple origins: https://example.com,https://app.example.com
CORS_ALLOWED_ORIGINS=*
